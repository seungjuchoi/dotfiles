# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# Font
font-family = JetBrains Mono
font-family = Monoplex KR Medium
font-family = Hack Nerd Font

# Appearance
theme = TokyoNight
shell-integration-features = no-cursor
cursor-style = block
window-padding-x = 10
window-padding-y = 10

# Terminal
term = xterm-256color
keybind = shift+enter=text:\x1b\r
# Ctrl+숫자 — Ghostty 탭 전환 대신 CSI u 로 그대로 흘려보낸다.
# 레거시 인코딩에서는 Ctrl+2/3/6 이 각각 NUL/ESC/C-^ 로 뭉뚱그려져 tmux 가
# 숫자를 구분하지 못하므로, tmux 가 C-1..C-9 로 인식하도록 CSI u 를 직접 보낸다
# (tmux 는 안쪽 앱에 다시 레거시 코드로 변환해 주므로 nvim 의 C-^ 등은 그대로).
# tmux 쪽 prefix + Ctrl+숫자 window 이동 바인딩과 짝을 이룬다.
keybind = ctrl+zero=text:\x1b[48;5u
keybind = ctrl+one=text:\x1b[49;5u
keybind = ctrl+two=text:\x1b[50;5u
keybind = ctrl+three=text:\x1b[51;5u
keybind = ctrl+four=text:\x1b[52;5u
keybind = ctrl+five=text:\x1b[53;5u
keybind = ctrl+six=text:\x1b[54;5u
keybind = ctrl+seven=text:\x1b[55;5u
keybind = ctrl+eight=text:\x1b[56;5u
keybind = ctrl+nine=text:\x1b[57;5u
keybind = ctrl+enter=text:\r

# Split navigation (cmd + shift + hjkl)
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right

# Split resize (cmd + ctrl + hjkl) — arrow 기본값 대체
keybind = cmd+ctrl+h=resize_split:left,10
keybind = cmd+ctrl+j=resize_split:down,10
keybind = cmd+ctrl+k=resize_split:up,10
keybind = cmd+ctrl+l=resize_split:right,10

macos-icon = official
