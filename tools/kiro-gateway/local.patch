diff --git a/kiro/converters_anthropic.py b/kiro/converters_anthropic.py
index ea297dc..e5dfa10 100644
--- a/kiro/converters_anthropic.py
+++ b/kiro/converters_anthropic.py
@@ -450,8 +450,20 @@ def anthropic_to_kiro(
     Raises:
         ValueError: If there are no messages to send
     """
-    # Convert messages to unified format
-    unified_messages = convert_anthropic_messages(request.messages)
+    # Claude Code custom models (e.g. claude-opus-5) may send role=system
+    # inside messages[] instead of the top-level system field. Fold those
+    # into the system prompt so Kiro only sees user/assistant turns.
+    inline_system = []
+    conversation_messages = []
+    for msg in request.messages:
+        if msg.role == "system":
+            text = convert_anthropic_content_to_text(msg.content)
+            if text:
+                inline_system.append(text)
+        else:
+            conversation_messages.append(msg)
+
+    unified_messages = convert_anthropic_messages(conversation_messages)
 
     # Convert tools to unified format
     unified_tools = convert_anthropic_tools(request.tools)
@@ -459,6 +471,9 @@ def anthropic_to_kiro(
     # System prompt is already separate in Anthropic format!
     # It can be a string or list of content blocks (for prompt caching)
     system_prompt = extract_system_prompt(request.system)
+    if inline_system:
+        extra = "\n\n".join(inline_system)
+        system_prompt = f"{system_prompt}\n\n{extra}" if system_prompt else extra
 
     # Get model ID for Kiro API (normalizes + resolves hidden models)
     # Pass-through principle: we normalize and send to Kiro, Kiro decides if valid
