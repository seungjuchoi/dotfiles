diff --git a/kiro/converters_anthropic.py b/kiro/converters_anthropic.py
index ea297dc..e5dfa10 100644
--- a/kiro/converters_anthropic.py
+++ b/kiro/converters_anthropic.py
@@ -450,8 +450,20 @@ def anthropic_to_kiro(
     Raises:
         ValueError: If there are no messages to send
     """
-    # Convert messages to unified format
-    unified_messages = convert_anthropic_messages(request.messages)
+    # Claude Code custom models (e.g. claude-opus-5) may send role=system
+    # inside messages[] instead of the top-level system field. Fold those
+    # into the system prompt so Kiro only sees user/assistant turns.
+    inline_system = []
+    conversation_messages = []
+    for msg in request.messages:
+        if msg.role == "system":
+            text = convert_anthropic_content_to_text(msg.content)
+            if text:
+                inline_system.append(text)
+        else:
+            conversation_messages.append(msg)
+
+    unified_messages = convert_anthropic_messages(conversation_messages)
 
     # Convert tools to unified format
     unified_tools = convert_anthropic_tools(request.tools)
@@ -459,6 +471,9 @@ def anthropic_to_kiro(
     # System prompt is already separate in Anthropic format!
     # It can be a string or list of content blocks (for prompt caching)
     system_prompt = extract_system_prompt(request.system)
+    if inline_system:
+        extra = "\n\n".join(inline_system)
+        system_prompt = f"{system_prompt}\n\n{extra}" if system_prompt else extra
 
     # Get model ID for Kiro API (normalizes + resolves hidden models)
     # Pass-through principle: we normalize and send to Kiro, Kiro decides if valid
diff --git a/kiro/mcp_tools.py b/kiro/mcp_tools.py
index c908ec5..6c0cb58 100644
--- a/kiro/mcp_tools.py
+++ b/kiro/mcp_tools.py
@@ -135,6 +135,12 @@ async def call_kiro_mcp_api(
             "arguments": {"query": query}
         }
     }
+
+    # AWS SSO OIDC (kiro-cli / Q Developer) tokens require profileArn on
+    # runtime.kiro.dev endpoints, including /mcp. Kiro Desktop tokens do not.
+    _mcp_profile_arn = getattr(auth_manager, "profile_arn", None)
+    if _mcp_profile_arn:
+        mcp_request["profileArn"] = _mcp_profile_arn
     
     # Log MCP request
     try:
@@ -153,6 +159,21 @@ async def call_kiro_mcp_api(
             "x-amzn-codewhisperer-optout": "false",
             "Content-Type": "application/json"
         }
+
+        # runtime.kiro.dev/mcp rejects unknown clients with
+        # 403 "User is not authorized to make this call." — the default
+        # httpx User-Agent is not accepted. Send the same Kiro client
+        # User-Agent used for the chat endpoints.
+        try:
+            _fp = auth_manager.fingerprint
+        except Exception:
+            _fp = "unknown"
+        headers["User-Agent"] = (
+            "aws-sdk-js/1.0.27 ua/2.1 os/win32#10.0.19044 lang/js "
+            "md/nodejs#22.21.1 api/codewhispererstreaming#1.0.27 m/E "
+            f"KiroIDE-0.7.45-{_fp}"
+        )
+        headers["x-amz-user-agent"] = f"aws-sdk-js/1.0.27 KiroIDE-0.7.45-{_fp}"
         
         mcp_url = f"{auth_manager.q_host}/mcp"
         logger.debug(f"Calling MCP API: {mcp_url}")
@@ -161,7 +182,7 @@ async def call_kiro_mcp_api(
             response = await client.post(mcp_url, json=mcp_request, headers=headers)
             
             if response.status_code != 200:
-                logger.error(f"MCP API error: {response.status_code}")
+                logger.error(f"MCP API error: {response.status_code} url={mcp_url} body={response.text[:2000]}")
                 return None, None
             
             mcp_response = response.json()
